GALLERY_ENV=development
DATABASE_URL=sqlite:///./data/gallery.db
STORAGE_DIR=./data/images
STORAGE_QUOTA_BYTES=10737418240
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=12000000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8040,http://localhost:4173,http://127.0.0.1:4173
COOKIE_SECURE=false
# Production uses a dedicated database and HTTPS.
